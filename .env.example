# Non-sensitive runtime configuration (NO hardcoded API keys — use Secret Manager in GCP)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Strategic Model Routing tiers
FAST_TRIAGE_MODEL=gemini-2.5-flash
DEEP_REASONING_MODEL=gemini-2.5-pro

# Optional Google Cloud Integrations (set true in GCP runtime)
ENABLE_CLOUD_DLP=false
ENABLE_CLOUD_TRACE=false
ENABLE_CLOUD_LOGGING=false
ENABLE_FIRESTORE_SESSIONS=false
ENABLE_GCP_SECRET_MANAGER=true
ENABLE_MODEL_ARMOR=false

# Optional persistent session / Vertex AI Search / Agent Engine bindings
# SESSION_DB_URL=sqlite+aiosqlite:///./sessions.db
# AGENT_ENGINE_ID=
# VERTEX_SEARCH_DATA_STORE_ID=
# MODEL_ARMOR_TEMPLATE_ID=
